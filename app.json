{
  "expo": {
    "name": "agora-frontend",
    "slug": "agora-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agorafrontend",
    "userInterfaceStyle": "automatic",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7221beb9-0d4a-45b2-af74-9d1f32dec2e0"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agora.frontend",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.693837597429-hds0b9m79q1b6uvboleqd4458lq1731a"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.693837597429-hds0b9m79q1b6uvboleqd4458lq1731a"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agora.frontend",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.693837597429-hds0b9m79q1b6uvboleqd4458lq1731a"
            },
            {
              "scheme": "com.googleusercontent.apps.93837597429-cba0e642fc22383ti1bvfc6o17crehqh"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1E488F",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se requiere acceso a la galería para adjuntar fotos a los reportes.",
          "cameraPermission": "Se requiere acceso a la cámara para tomar fotos para los reportes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se requiere acceso a tu ubicación para mostrarte en el mapa del campus."
        }
      ]
    ],
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
